# ===== MySQL =====
DB_URL=jdbc:mysql://localhost:3306/future_self?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== WeChat =====
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MOCK_LOGIN=true

# ===== Text AI =====
AI_TEXT_PROVIDER=mock
AI_TEXT_BASE_URL=
AI_TEXT_API_KEY=
AI_TEXT_MODEL=

# ===== Audio AI：mock | tencent（长文本异步）| tencent-sync（基础同步+150字分段拼接）
AI_AUDIO_PROVIDER=mock
AI_AUDIO_BASE_URL=
AI_AUDIO_API_KEY=
AI_AUDIO_VOICE_ID=
# 音色示例：大模型 501004(月华)/501001(智兰)；精品 101001(智瑜)
AI_AUDIO_MOCK_DELAY_MS=3000
AI_AUDIO_MOCK_FIXTURE_DIR=./data/mock-audio
# 腾讯云 TTS（provider=tencent / tencent-sync 时必填；只放本地 .env，禁止提交）
AI_AUDIO_TENCENT_SECRET_ID=
AI_AUDIO_TENCENT_SECRET_KEY=
AI_AUDIO_TENCENT_REGION=ap-guangzhou
AI_AUDIO_SYNC_OUTPUT_DIR=./data/tencent-sync

# ===== Storage =====
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./data/media

# ===== Admin bootstrap (local only; production must change) =====
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=

# ===== Rate limits（§24，按用户） =====
RATE_LIMIT_GOAL_PER_HOUR=30
RATE_LIMIT_FOLLOWUP_PER_HOUR=20
RATE_LIMIT_STORY_PER_DAY=10
RATE_LIMIT_RETRY_AUDIO_PER_DAY=5

# ===== 数据保留（§25.2） =====
RETENTION_DELETED_AUDIO_DAYS=30
