/**
 * 动效 — 实施文档 §41.8。动效只服务于“柔和、沉浸”，不炫技。
 * 低端安卓禁用大面积实时 blur；半透明优先 rgba，不用 backdrop-filter。
 */

/* —— Orb 呼吸（3000~4500ms，scale 0.96→1.03 + opacity）—— */
@keyframes orb-breath {
  0%, 100% { transform: scale(0.96); opacity: 0.9; }
  50%      { transform: scale(1.03); opacity: 1; }
}
.anim-orb-breath {
  animation: orb-breath 3.6s ease-in-out infinite;
}

/* —— 页面元素淡入上移（220~320ms，translateY 8~12rpx）—— */
@keyframes fade-up {
  from { opacity: 0; transform: translateY(12rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
.anim-fade-up {
  animation: fade-up 0.28s ease-out both;
}

@keyframes fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}
.anim-fade-in {
  animation: fade-in 0.24s ease-out both;
}

/* —— 卡片点击（100~140ms，scale 0.985）—— */
.anim-press {
  transform: scale(0.985);
  opacity: 0.92;
  transition: transform 0.12s ease-out, opacity 0.12s ease-out;
}

/* —— 底部 Sheet（260~340ms）—— */
.sheet-ease {
  transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
}

/* —— 生成中文字轮换淡入 —— */
@keyframes soft-blink {
  0%, 100% { opacity: 0.55; }
  50%      { opacity: 1; }
}
.anim-soft-blink {
  animation: soft-blink 2.4s ease-in-out infinite;
}

/* —— 加载圈（primary-button loading 态）—— */
@keyframes spinner-rotate {
  to { transform: rotate(360deg); }
}
.anim-spinner {
  animation: spinner-rotate 0.8s linear infinite;
}

/* —— 尊重系统减弱动效设置 —— */
@media (prefers-reduced-motion: reduce) {
  .anim-orb-breath,
  .anim-fade-up,
  .anim-fade-in,
  .anim-soft-blink,
  .anim-spinner {
    animation: none;
  }
}
