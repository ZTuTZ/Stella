/* affirmation-card — 叠放纸张卡片堆（§41.5.6），非普通列表 */
.stack {
  position: relative;
  padding-bottom: 28rpx;
}

/* 叠层：浅紫 → 浅粉，宽度递减 */
.layer {
  position: absolute;
  left: 50%;
  height: 88rpx;
  border-radius: var(--radius-md);
  transform: translateX(-50%);
}
.layer-1 {
  bottom: 10rpx;
  width: 92%;
  background: var(--color-surface-lilac);
  opacity: 0.75;
}
.layer-2 {
  bottom: 0;
  width: 84%;
  background: var(--color-surface-pink);
  opacity: 0.55;
}

.card {
  position: relative;
  z-index: 1;
  min-height: 340rpx;
  border-radius: var(--radius-md);
  background: #FFF9F6;
  box-shadow: var(--shadow-card);
  padding: 96rpx 48rpx 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.card-pressed { transform: scale(0.985); opacity: 0.95; }

.text {
  font-family: var(--font-serif);
  font-size: 38rpx;
  font-weight: 400;
  line-height: 1.45;
  color: var(--color-text);
  text-align: center;
}

.footer {
  position: absolute;
  bottom: 28rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.action {
  position: absolute;
  top: 24rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.action-left { left: 24rpx; }
.action-right { right: 24rpx; }

.heart { font-size: 34rpx; color: var(--color-text-tertiary); line-height: 1; }
.heart.is-favorite { color: var(--color-heart); }
.more { font-size: 32rpx; color: var(--color-text-tertiary); line-height: 1; }
