<view wx:if="{{visible}}" class="mini-player">
  <view wx:if="{{progressPct > 0}}" class="progress-line" style="width:{{progressPct}}%"></view>
  <view class="inner">
    <view class="mini-orb" catchtap="onOpen"></view>
    <view class="meta" catchtap="onOpen">
      <text class="mini-title">{{title}}</text>
      <text class="mini-time">{{currentTime}} / {{duration}}</text>
    </view>
    <view class="mini-play" hover-class="mini-pressed" catchtap="onPlay">
      <text class="mini-play-icon">{{playing ? '❚❚' : '▶'}}</text>
    </view>
  </view>
</view>
