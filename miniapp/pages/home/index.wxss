.page {
  min-height: 100vh;
  padding: 96rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.orb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: var(--gradient-orb);
  box-shadow: var(--shadow-floating);
  margin-top: 96rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 64rpx;
}

.hero-title {
  font-family: var(--font-serif);
  font-size: 60rpx;
  font-weight: 400;
  line-height: 1.1;
}

.hero-sub {
  margin-top: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
  text-align: center;
  max-width: 560rpx;
}

.placeholder {
  margin-top: auto;
  padding: 24rpx;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}
