/* settings — 设置页（§42.5）：与整体相同的柔和视觉系统 */
.settings {
  min-height: 100vh;
  padding: 48rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.back { font-size: 40rpx; color: var(--color-text); padding: 8rpx 16rpx 8rpx 0; }
.top-title { font-size: 26rpx; }
.spacer { width: 56rpx; }

.card {
  margin-top: 40rpx;
  padding: 40rpx 36rpx;
  border-radius: var(--radius-md);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.card-title {
  display: block;
  font-size: 34rpx;
  margin-bottom: 20rpx;
}

.card-text {
  display: block;
  margin-bottom: 16rpx;
  line-height: 1.7;
}

.logout {
  margin-top: 24rpx;
  height: 84rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(200, 93, 114, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}
.logout-pressed { opacity: 0.7; }
.logout-text { font-size: 26rpx; color: var(--color-heart); }

.version {
  display: block;
  text-align: center;
  margin-top: 64rpx;
}
