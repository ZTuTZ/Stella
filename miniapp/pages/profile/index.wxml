<view class="profile">
  <view class="head anim-fade-up">
    <dream-orb size="{{120}}" />
    <text class="name">{{displayName || '微信用户'}}</text>
    <text class="sub t-tertiary">把想要的人生，慢慢说给自己听</text>
  </view>

  <!-- 大块浅色入口（§41.6.9）：3~5 个 -->
  <view class="menu">
    <view class="menu-item" hover-class="menu-pressed" bindtap="onEditProfile">
      <text class="menu-text t-body">我的人生档案</text>
      <text class="arrow">→</text>
    </view>
    <view class="menu-item" hover-class="menu-pressed" bindtap="onLibrary">
      <text class="menu-text t-body">我的故事收藏</text>
      <text class="arrow">→</text>
    </view>
    <view class="menu-item" hover-class="menu-pressed" bindtap="onSettings">
      <text class="menu-text t-body">设置</text>
      <text class="arrow">→</text>
    </view>
  </view>
</view>
