/* profile — 我的（§41.6.9）：简洁，保持 bg-soft 不切纯白 */
.profile {
  min-height: 100vh;
  padding: 96rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.head {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.name {
  margin-top: 32rpx;
  font-family: var(--font-serif);
  font-size: 44rpx;
  color: var(--color-text);
}

.sub { margin-top: 16rpx; }

.menu {
  width: 100%;
  margin-top: 72rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 36rpx;
  border-radius: var(--radius-md);
  background: rgba(255, 249, 246, 0.7);
  border: 1rpx solid var(--color-line);
}
.menu-pressed { opacity: 0.7; transform: scale(0.99); }
.menu-text { color: var(--color-text); }
.arrow { color: var(--color-text-tertiary); }
