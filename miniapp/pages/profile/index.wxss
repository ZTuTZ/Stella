/* profile — 我的（占位；UI Phase 4 按 §41.6.9 实装） */
.profile {
  min-height: 100vh;
  padding: 96rpx 32rpx 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.name {
  margin-top: 32rpx;
  font-family: var(--font-serif);
  font-size: 44rpx;
  color: var(--color-text);
}

.note { margin-top: 16rpx; }

.menu {
  width: 100%;
  margin-top: 64rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 36rpx;
  border-radius: var(--radius-md);
  background: rgba(255, 249, 246, 0.7);
  border: 1rpx solid var(--color-line);
}
.menu-pressed { opacity: 0.7; }
.menu-text { color: var(--color-text); }
.arrow { color: var(--color-text-tertiary); }
