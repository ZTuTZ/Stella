/* design-system 展示页（仅开发环境） */
.page {
  padding: 48rpx 32rpx 96rpx;
}

.dev-banner {
  display: block;
  padding: 20rpx 28rpx;
  border-radius: var(--radius-sm);
  background: rgba(33, 28, 31, 0.85);
  color: #FFF9F6;
  font-size: 24rpx;
  margin-bottom: 40rpx;
}

.section {
  margin-top: 48rpx;
}

.section-title {
  display: block;
  font-family: var(--font-serif);
  font-size: 32rpx;
  color: var(--color-text);
  margin-bottom: 24rpx;
}

.state-note {
  display: block;
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
}

.row.wrap { flex-wrap: wrap; }
.col { display: flex; flex-direction: column; gap: 24rpx; }
.spacer { height: 24rpx; }

.card-slot { width: 320rpx; }
.card-slot.wide { width: 100%; }
