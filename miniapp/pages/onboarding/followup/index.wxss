/* onboarding/followup — 对话式追问（§41.6.2）：Orb 强化对话感 */
.ob { min-height: 100vh; padding: calc(var(--sb) + 88rpx) 32rpx 0; box-sizing: border-box; display: flex; flex-direction: column; }
.top { display: flex; align-items: center; justify-content: space-between; }
.back { font-size: 40rpx; color: var(--color-text); padding: 8rpx 16rpx 8rpx 0; }
.q { margin-top: 64rpx; }
.question { display: block; font-family: var(--font-serif); font-size: 44rpx; line-height: 1.25; color: var(--color-text); }
.question.inline { margin-top: 48rpx; }
.q-sub { display: block; margin-top: 24rpx; }

.center { margin-top: 160rpx; display: flex; flex-direction: column; align-items: center; }
.center-text { margin-top: 40rpx; font-size: 26rpx; color: var(--color-text-secondary); }

.answer-textarea {
  margin-top: 48rpx;
  width: 100%;
  height: 240rpx;
  padding: 28rpx 32rpx;
  border-radius: var(--radius-md);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--color-text);
  box-sizing: border-box;
}
.answer-placeholder { color: var(--color-text-tertiary); }

.skip-link {
  display: inline-block;
  margin-top: 24rpx;
  padding: 8rpx 8rpx;
}

.bottom-area { margin-top: auto; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
