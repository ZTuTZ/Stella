/* onboarding/context — 复用单问题式规范 */
.ob {
  min-height: 100vh;
  padding: calc(var(--sb) + 88rpx) 32rpx 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.top { display: flex; align-items: center; justify-content: space-between; }
.back { font-size: 40rpx; color: var(--color-text); padding: 8rpx 16rpx 8rpx 0; }
.q { margin-top: 96rpx; }
.hint { display: block; margin-bottom: 16rpx; }

.question {
  display: block;
  font-family: var(--font-serif);
  font-size: 48rpx;
  line-height: 1.2;
  color: var(--color-text);
}

.answer-textarea {
  margin-top: 56rpx;
  width: 100%;
  height: 320rpx;
  padding: 32rpx 36rpx;
  border-radius: var(--radius-md);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--color-text);
  box-sizing: border-box;
}
.answer-placeholder { color: var(--color-text-tertiary); }

.person {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 24rpx 32rpx;
  border-radius: var(--radius-md);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}
.person-name { font-size: 26rpx; color: var(--color-text); }
.person-remove { font-size: 24rpx; color: var(--color-text-tertiary); }

.person-form {
  margin-top: 32rpx;
  padding: 28rpx;
  border-radius: var(--radius-md);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}
.form-input {
  height: 84rpx;
  font-size: 28rpx;
  color: var(--color-text);
  border-bottom: 1rpx solid var(--color-line);
}
.person-actions {
  display: flex;
  justify-content: flex-end;
  gap: 40rpx;
  margin-top: 24rpx;
}
.link { padding: 8rpx 16rpx; }

.add-person {
  margin-top: 40rpx;
  height: 92rpx;
  border-radius: var(--radius-md);
  border: 1rpx dashed var(--color-line);
  display: flex;
  align-items: center;
  justify-content: center;
}
.add-pressed { opacity: 0.7; }
.add-text { font-size: 26rpx; color: var(--color-text-secondary); }

.bottom-area {
  margin-top: auto;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}
