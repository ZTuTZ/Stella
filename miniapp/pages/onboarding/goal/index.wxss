/* onboarding/goal — 与 basic/context 相同的单问题式规范 */
.ob { min-height: 100vh; padding: calc(var(--sb) + 48rpx) 32rpx 0; box-sizing: border-box; display: flex; flex-direction: column; }
.top { display: flex; align-items: center; justify-content: space-between; }
.back { font-size: 40rpx; color: var(--color-text); padding: 8rpx 16rpx 8rpx 0; }
.q { margin-top: 96rpx; }
.hint { display: block; margin-bottom: 16rpx; }
.question { display: block; font-family: var(--font-serif); font-size: 48rpx; line-height: 1.2; color: var(--color-text); }
.q-sub { display: block; margin-top: 16rpx; }

.answer-input {
  margin-top: 64rpx;
  padding: 32rpx 36rpx;
  border-radius: var(--radius-md);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
  font-size: 30rpx;
  color: var(--color-text);
}
.answer-textarea {
  margin-top: 56rpx;
  width: 100%;
  height: 360rpx;
  padding: 32rpx 36rpx;
  border-radius: var(--radius-md);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--color-text);
  box-sizing: border-box;
}
.answer-placeholder { color: var(--color-text-tertiary); }
.error { display: block; margin-top: 20rpx; color: var(--color-heart); }

.chips { display: flex; flex-wrap: wrap; gap: 20rpx; margin-top: 56rpx; }

.bottom-area { margin-top: auto; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
