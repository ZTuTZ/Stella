/* story/list — 我的故事 / Library（§41.6.7）：衬线大标题 + 轻筛选 + 两列网格 */
.library {
  min-height: 100vh;
  padding: 48rpx 32rpx 96rpx;
  box-sizing: border-box;
}

.top { display: flex; align-items: center; }
.back { font-size: 40rpx; color: var(--color-text); padding: 8rpx 16rpx 8rpx 0; }

.page-title {
  display: block;
  margin-top: 40rpx;
  font-size: 52rpx;
}

.filters {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 28rpx;
}

.filter {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
  padding: 8rpx 4rpx;
}
.filter.is-active {
  color: var(--color-text);
  font-weight: 500;
  border-bottom: 2rpx solid var(--color-primary-btn);
}
.filter-divider { color: var(--color-line); }

/* 两列网格：单卡宽 (750 - 32*2 - 20) / 2 ≈ 333rpx（§41.6.7） */
.grid {
  margin-top: 40rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.grid-item { width: 333rpx; }

/* 空状态 */
.empty {
  margin-top: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}
.empty-title {
  font-family: var(--font-serif);
  font-size: 36rpx;
  color: var(--color-text);
}
.empty-sub { text-align: center; }
.empty-action { margin-top: 32rpx; width: 100%; }

.loading-more {
  display: block;
  text-align: center;
  margin-top: 40rpx;
}
