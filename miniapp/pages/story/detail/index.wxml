<view class="detail" style="--sb:{{statusBarHeight}}px">
  <!-- 上半屏：沉浸封面（§41.6.6） -->
  <view class="cover">
    <view class="cover-orb"></view>
    <view class="cover-overlay"></view>

    <view class="top-bar">
      <view class="icon-btn cover-icon" hover-class="icon-pressed" bindtap="goBack">
        <text class="icon">←</text>
      </view>
      <view class="top-right">
        <view class="icon-btn cover-icon" hover-class="icon-pressed" bindtap="onFavorite">
          <text class="icon {{story.favorite ? 'heart-active' : ''}}">{{story.favorite ? '♥' : '♡'}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="cover-center">
      <dream-orb size="{{140}}" breathing="{{true}}" />
    </view>

    <view wx:elif="{{story}}" class="cover-title-wrap">
      <text class="cover-title">{{story.title}}</text>
      <text class="ai-badge">AI 生成内容</text>
    </view>
  </view>

  <!-- 下半屏：播放器 + 全文 -->
  <view wx:if="{{story}}" class="below">
    <view class="player-card">
      <audio-player
        title="{{story.title}}"
        status="{{playerStatus}}"
        playing="{{playerPlaying}}"
        progressPct="{{playerProgressPct}}"
        currentTime="{{playerCurrentTime}}"
        duration="{{playerDuration}}"
        selectedAmbience="{{selectedAmbience}}"
        bind:play="onPlayTap"
        bind:seek="onSeek"
        bind:ambience="onAmbience"
        bind:retry="onRetryAudio"
      />
    </view>

    <view class="content-section">
      <view class="content-toggle" hover-class="toggle-pressed" bindtap="toggleContent">
        <text class="toggle-text">{{contentExpanded ? '收起全文 ↑' : '阅读故事全文 ↓'}}</text>
      </view>
      <view wx:if="{{contentExpanded}}" class="body anim-fade-up">
        <text wx:for="{{paragraphs}}" wx:key="index" class="paragraph t-longform">{{item}}</text>
      </view>
      <view wx:else class="body preview">
        <text wx:for="{{previewParagraphs}}" wx:key="index" class="paragraph t-longform preview-paragraph">{{item}}</text>
      </view>
    </view>
  </view>

  <view wx:elif="{{!loading}}" class="below">
    <view class="missing">
      <text class="missing-text t-secondary">故事不存在或已删除</text>
    </view>
  </view>

  <mini-player visible="{{false}}" />
</view>
