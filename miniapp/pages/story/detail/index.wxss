/* story/detail — 极简阅读版（UI Phase 3 将升级为沉浸封面 + 播放器） */
.detail {
  min-height: 100vh;
  padding: 48rpx 32rpx 96rpx;
  box-sizing: border-box;
}

.top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.back {
  font-size: 40rpx;
  color: var(--color-text);
  padding: 8rpx 16rpx 8rpx 0;
}

.ai-badge {
  padding: 8rpx 20rpx;
  border-radius: var(--radius-pill);
  background: rgba(33, 28, 31, 0.06);
}

.center {
  margin-top: 320rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

.title {
  display: block;
  margin-top: 64rpx;
  font-family: var(--font-serif);
  font-size: 52rpx;
  font-weight: 400;
  line-height: 1.2;
  color: var(--color-text);
}

.summary {
  display: block;
  margin-top: 24rpx;
}

.audio-hint {
  margin-top: 32rpx;
  padding: 20rpx 28rpx;
  border-radius: var(--radius-md);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}
.audio-hint-text { font-size: 24rpx; color: var(--color-text-secondary); }

.body {
  margin-top: 56rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}
