/* story/detail — 沉浸封面 + 播放器（§41.6.6）：视觉权重最高页 */
.detail {
  min-height: 100vh;
  background: var(--color-bg-soft);
}

/* —— 上半屏封面（45~58vh）—— */
.cover {
  position: relative;
  height: 50vh;
  background: var(--gradient-card-lilac);
  overflow: hidden;
}

.cover-orb {
  position: absolute;
  top: 18%;
  left: 50%;
  width: 280rpx;
  height: 280rpx;
  transform: translateX(-50%);
  border-radius: 50%;
  background: var(--gradient-orb);
  box-shadow: 0 24rpx 80rpx rgba(71, 46, 58, 0.25);
}

/* 图片上文字可读：三段柔和暗化（§41.2.2），非硬黑渐变 */
.cover-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(20, 15, 18, 0.06) 0%,
    rgba(20, 15, 18, 0.14) 55%,
    rgba(20, 15, 18, 0.42) 100%
  );
}

.top-bar {
  position: absolute;
  top: calc(24rpx + var(--sb));
  left: 32rpx;
  right: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 2;
}

.top-right { display: flex; gap: 20rpx; }

.icon-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.icon-pressed { transform: scale(0.94); opacity: 0.85; }

/* 封面上的按钮：半透明白底浅字（透明导航 §41.9） */
.cover-icon {
  background: rgba(255, 249, 246, 0.22);
  backdrop-filter: none;
}
.icon { font-size: 32rpx; line-height: 1; color: #FFF9F6; }
.icon.heart-active { color: #FFB3C2; }

.cover-center {
  position: absolute;
  top: 40%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.cover-title-wrap {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  bottom: 44rpx;
  z-index: 2;
}

.cover-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  font-family: var(--font-serif);
  font-size: 44rpx;
  font-weight: 400;
  line-height: 1.25;
  color: #FFF9F6;
}

.ai-badge {
  display: inline-block;
  margin-top: 16rpx;
  padding: 6rpx 20rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 249, 246, 0.2);
  font-size: 20rpx;
  color: rgba(255, 249, 246, 0.85);
}

/* —— 下半屏 —— */
.below { padding: 0 32rpx 96rpx; }

/* 播放器卡片上叠封面（两层结构 §41.6.6） */
.player-card {
  margin-top: -72rpx;
  position: relative;
  z-index: 3;
  box-shadow: var(--shadow-floating);
}

.content-section { margin-top: 48rpx; }

.content-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: var(--radius-md);
  background: rgba(255, 249, 246, 0.6);
  border: 1rpx solid var(--color-line);
}
.toggle-pressed { opacity: 0.7; }
.toggle-text { font-size: 26rpx; color: var(--color-text-secondary); }

.body {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* 预览态（未展开）：最后一行渐隐提示还有更多 */
.preview { max-height: 260rpx; overflow: hidden; }
.preview-paragraph:last-child {
  -webkit-line-clamp: 2;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.missing {
  margin-top: 120rpx;
  display: flex;
  justify-content: center;
}
.missing-text { text-align: center; }
