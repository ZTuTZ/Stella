/* custom-tab-bar — 仅首页/我的（§41.9）；与粉底连续，无白块 */
.tab-bar {
  display: flex;
  flex-direction: row;
  background: rgba(253, 244, 240, 0.96);
  backdrop-filter: blur(0px);
  padding: 16rpx 0 calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-line);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-line);
  transition: background 0.15s ease-out;
}
.dot.is-active { background: var(--color-primary-btn); }

.tab-text {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}
.tab-text.is-active { color: var(--color-text); font-weight: 500; }
